#!/bin/bash
# vm-bootstrap.sh — idempotently restore everything a VM replacement
# wipes, so the health loop can self-heal. Called by the loop after a
# failed bootstrap-check; safe to run any time. Single instance (flock).
# Principles:
#   - canonical copies live in the persistent home / records repo;
#     volatile paths (/root, /usr) get mirrors, never the originals.
#   - hand-started GUI processes (Beeper) die with the VM: relaunch.
exec 9>/tmp/vm-bootstrap.lock
flock -n 9 || { echo "vm-bootstrap: another instance is running"; exit 0; }

H="$HOME"
FAIL=0
log() { echo "bootstrap: $*"; }

# 1. mirrors into volatile paths (examples — adapt to your gate/tooling)
# Skip this whole section if $HOME *is* /root (the copies would be onto
# themselves).
mkdir -p /root/.ssh && chmod 700 /root/.ssh
[ -f "$H/.ssh/config" ] && cp "$H/.ssh/config" /root/.ssh/config && chmod 600 /root/.ssh/config
if [ -f "$H/.config/gh/hosts.yml" ]; then
  mkdir -p /root/.config/gh
  cp "$H/.config/gh/hosts.yml" /root/.config/gh/hosts.yml
  chmod 600 /root/.config/gh/hosts.yml
  log "gh mirror OK"
fi

# 2. temp dir on the big disk if /tmp is a small tmpfs (adapt size/paths)
mkdir -p "$H/workspace/big-tmp"

# 3. Beeper: a running process is not enough — the API must answer.
# A hung process is killed (bracket form) and relaunched; after a
# launch, poll the API (any HTTP status, even 401, means it is up)
# for up to ~90s — the app starts slower than a process check.
# Pass BEEPER_PROXY through if your egress needs it — a relaunch from a
# bare cron environment otherwise loses the proxy the launcher needs.
# Credential-free CONNECT URL only; a credentialed one goes stale.
api_up() { curl -s -o /dev/null -m 3 http://127.0.0.1:23373/v1/accounts; }
if pgrep -f '[b]eepertexts' >/dev/null 2>&1 && api_up; then
  log "beeper: already running, API up"
elif [ -x "$H/workspace/beeper-diag/launch-beeper.sh" ]; then
  pkill -f '[b]eepertexts' 2>/dev/null; sleep 3
  BEEPER_PROXY="${BEEPER_PROXY:-}" bash "$H/workspace/beeper-diag/launch-beeper.sh" >/dev/null 2>&1
  ok=0
  for _ in $(seq 18); do sleep 5; if api_up; then ok=1; break; fi; done
  if [ "$ok" = 1 ]; then log "beeper: relaunched OK"; else log "beeper: relaunch FAILED"; FAIL=1; fi
fi

# 4. locales (optional — only if your tooling depends on a specific one)
# locale-gen en_US.UTF-8 2>/dev/null || true

# 5. system tools on the restore list. Declare every tool installed
# outside $HOME here, in the same change that installs it (see
# durability/RESTART-SURVIVAL.md). Check-then-install, idempotent:
#   ensure_tool() { command -v "$1" >/dev/null 2>&1 || { log "restoring $1"; <install command> || FAIL=1; }; }
#   ensure_tool ruby        # e.g. apt-get install -y ruby
#   ensure_tool <tool>
# Service units are restored the same way: keep the unit files in
# $HOME, copy them into /etc/systemd/system here, daemon-reload and
# enable. A unit that exists only in /etc is a unit that will vanish.

exit $FAIL
